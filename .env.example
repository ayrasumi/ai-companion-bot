# ============================================================
#  AI Companion Bot — configuración
#  Copia este archivo como ".env" y rellena los valores.
# ============================================================

# --- Discord ------------------------------------------------
# https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=tu_token_aqui

# ID de la aplicación (Developer Portal -> General Information)
DISCORD_CLIENT_ID=tu_client_id_aqui

# Opcional: si defines esto, los comandos se registran solo en
# ese servidor (instantáneo). Si lo dejas vacío, se registran
# globalmente (puede tardar hasta 1 hora).
DISCORD_GUILD_ID=

# --- Modelo de IA -------------------------------------------
# Cualquier endpoint compatible con la API de OpenAI sirve:
#   OpenAI        -> https://api.openai.com/v1          + gpt-4o-mini
#   OpenRouter    -> https://openrouter.ai/api/v1       + openrouter/auto
#   DeepSeek      -> https://api.deepseek.com/v1        + deepseek-chat
#   Ollama local  -> http://localhost:11434/v1          + llama3.1
#   LM Studio     -> http://localhost:1234/v1           + modelo local
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=tu_api_key_aqui
LLM_MODEL=gpt-4o-mini

# Temperatura (0 = predecible, 1.2 = creativo)
LLM_TEMPERATURE=0.8

# Máximo de tokens de la respuesta
LLM_MAX_TOKENS=400

# --- Comportamiento -----------------------------------------
# Cuántos mensajes de historial se le mandan al modelo por usuario
HISTORY_WINDOW=20

# Ruta al archivo de personalidad
PERSONA_FILE=config/persona.json

# Archivo de base de datos (memoria persistente)
DATABASE_PATH=data/memory.db
